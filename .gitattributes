# Shell scripts and workflows MUST use LF — they are authored on Windows but
# execute on arm64 Linux runners. CRLF causes `bad interpreter: /usr/bin/env bash^M`.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf
*.md   text eol=lf

# C/C++ sources and the build system are compiled on arm64 Linux.
*.cpp  text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.inc  text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf

# Never let git mangle model or result binaries
*.gguf binary
*.data binary
